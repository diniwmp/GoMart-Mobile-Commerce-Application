<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/notif_icon_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:layout_marginEnd="12dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_notif_icon">

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold" />

            <View
                android:id="@+id/notif_unread_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_unread_dot"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/notif_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_grey"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/poppins" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/p_address_grey"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/notif_unread_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_orange_badge"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:fontFamily="@font/poppins_bold"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/notif_btn_clear"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:src="@drawable/close_24"
        android:padding="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/p_address_grey" />

</LinearLayout>