<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:padding="8dp"
android:gravity="center_vertical">

<ImageView
    android:id="@+id/invoice_row_image"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:scaleType="centerCrop" />

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginStart="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/invoice_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/product_title_text"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurface"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/invoice_row_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/qty_ex_name"
        android:textSize="12sp"
        android:textColor="@color/text_grey" />

    <TextView
        android:id="@+id/invoice_row_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/products_price_text"
        android:textSize="12sp"
        android:textColor="@color/text_grey" />

</LinearLayout>

<TextView
    android:id="@+id/invoice_row_total"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="13sp"
    android:textStyle="bold"
    android:text="@string/products_price_text"
    android:textColor="?attr/colorOnSurface" />

</LinearLayout>