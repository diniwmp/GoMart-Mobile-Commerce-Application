<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sign_in_forgot_password"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/forgot_pw_sub_text"
        android:textSize="13sp"
        android:textColor="@color/text_grey" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/forgot_pw_email_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <EditText
        android:id="@+id/forgot_email_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/custom_edit_text"
        android:hint="@string/profile_email_text_text"
        android:inputType="textEmailAddress"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/forgot_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/orange"
        android:visibility="gone" />

    <TextView
        android:id="@+id/forgot_success_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/grey_light"
        android:textColor="@color/dark_green"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <Button
        android:id="@+id/forgot_send_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/custom_button"
        android:text="@string/forgot_pw_btn_text"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins_bold"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:textSize="15sp"
        android:textStyle="bold" />



    <TextView
        android:id="@+id/forgot_cancel_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:text="@string/cancel_text"
        android:textColor="@color/text_grey"
        android:textSize="13sp" />

</LinearLayout>
